APP_NAME=Crypto Exchange
DEBUG=True

SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Async engine (psycopg v3) — used by the running app
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/crypto_trading_engine
# Sync engine (psycopg2) — used by Alembic migrations only
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/crypto_trading_engine

REDIS_URL=redis://localhost:6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
